{
  "name": "study-state",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4318",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4318",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/database.ts migrate",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/database.ts backup",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/database.ts restore",
    "db:seed-demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0"
}
